# Copy to app_25.0/.Renviron (gitignored) and fill real values before deploy.
# Social login will redirect to Google / Facebook only after these are set.

# --- Recommended: Supabase Auth (covers Google + Facebook in one project) ---
# YNOW_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# YNOW_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# YNOW_OAUTH_REDIRECT_URI=https://hopesmasher1118.shinyapps.io/TheYNowApp
# In Supabase Dashboard → Authentication → Providers: enable Google + Facebook.
# Add the redirect URI under Authentication → URL Configuration → Redirect URLs.

# --- Or direct OAuth (no Supabase) ---
# YNOW_GOOGLE_CLIENT_ID=
# YNOW_GOOGLE_CLIENT_SECRET=
# YNOW_FACEBOOK_APP_ID=
# YNOW_FACEBOOK_APP_SECRET=
# YNOW_OAUTH_STATE_SECRET=replace-with-a-long-random-string
# YNOW_OAUTH_REDIRECT_URI=https://hopesmasher1118.shinyapps.io/TheYNowApp
# Google Cloud Console → OAuth client (Web) Authorized redirect URI = YNOW_OAUTH_REDIRECT_URI
# Meta Developer → Facebook Login Valid OAuth Redirect URIs = same URI

# Optional Email demo login (existing)
# YNOW_AUTH_DEMO_EMAIL=you@example.com
# YNOW_AUTH_DEMO_PASSWORD=change-me
# YNOW_ENABLE_ACCOUNT_LOGIN=1
